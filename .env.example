# Copy to .env. Fully local mode needs only GOOGLE_API_KEY (local numpy index, tools in-process).
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSION=768
# ---- AWS mode (filled by `make env` after `make infra-apply`) ----
AWS_PROFILE=shopease
AWS_REGION=ap-southeast-2
DOCS_BUCKET=
VECTOR_BUCKET=
VECTOR_INDEX=handbook
TOOLS_LAMBDA=
API_URL=
API_TOKEN=
